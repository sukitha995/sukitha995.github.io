---
import { Icon } from 'astro-icon/components'
import { NAV_LINKS } from '../data.js'
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-background/50 backdrop-blur-sm transition-all duration-300"
>
  <div id="nav-progress" class="h-0.5 bg-accent" style="width: 0%" aria-hidden="true"></div>
  <nav aria-label="Main navigation" class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="#home" class="rounded text-lg font-bold tracking-tight focus:outline-none focus:ring-2 focus:ring-accent">
      <span class="text-accent">KS.</span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link rounded text-sm text-muted transition-colors duration-300 hover:text-ink focus:outline-none focus:ring-2 focus:ring-accent"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      id="nav-toggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="flex h-10 w-10 items-center justify-center rounded-md border border-line text-ink transition-all duration-300 hover:border-accent hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent md:hidden"
    >
      <Icon id="nav-toggle-icon-menu" name="lucide:menu" class="h-5 w-5" aria-hidden="true" />
      <Icon id="nav-toggle-icon-close" name="lucide:x" class="hidden h-5 w-5" aria-hidden="true" />
    </button>
  </nav>

  <div id="mobile-menu" class="border-t border-line md:hidden">
    <ul class="mx-auto max-w-6xl space-y-1 px-4 py-4">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link block rounded-md px-4 py-3 text-muted transition-colors duration-300 hover:bg-card hover:text-ink focus:outline-none focus:ring-2 focus:ring-accent"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>