---
import { Icon } from 'astro-icon/components'
import { PROJECTS } from '../data.js'
import BrandIcon from './BrandIcon.astro'
---

<section id="projects" class="scroll-mt-24 border-b border-line">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="reveal mx-auto mb-12 max-w-2xl text-center">
      <p class="mb-2 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-widest text-accent">
        <Icon name="lucide:sparkles" class="h-3.5 w-3.5" aria-hidden="true" />
        Projects
      </p>
      <h2 class="text-3xl font-bold sm:text-4xl">Selected Work</h2>
      <p class="mt-4 text-muted">Machine learning, data, and cloud engineering projects.</p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        PROJECTS.map((project, index) => (
          <article
            class="reveal group flex h-full flex-col rounded-lg border border-line bg-card p-6 transition-all duration-300 hover:-translate-y-2 hover:border-accent/60 hover:shadow-xl hover:shadow-accent/5"
            style={`--reveal-delay: ${(index % 3) * 80}ms`}
          >
            <div class="mb-4 flex items-center justify-between">
              <span
                class="flex h-11 w-11 items-center justify-center rounded-md border border-accent/30 bg-background text-accent transition-transform duration-300 group-hover:scale-110"
              >
                <Icon name={`lucide:${project.icon}`} class="h-5 w-5" aria-hidden="true" />
              </span>
              <span class="font-mono text-sm text-subtle">#{project.number}</span>
            </div>
            <h3 class="mb-2 font-semibold leading-snug text-ink">{project.title}</h3>
            <p class="mb-4 flex-1 text-sm leading-relaxed text-muted">{project.description}</p>
            <ul class="mb-5 flex flex-wrap gap-2">
              {
                project.tech.map((tech) => (
                  <li
                    class="rounded-full border border-line px-3 py-1 text-xs text-muted transition-colors duration-300 hover:border-accent/60 hover:text-ink"
                  >
                    {tech}
                  </li>
                ))
              }
            </ul>
            <a
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-semibold text-accent transition-colors duration-300 hover:text-accent-bright focus:outline-none focus:ring-2 focus:ring-accent"
            >
              <BrandIcon name="github" class="h-4 w-4" />
              View on GitHub
              <Icon
                name="lucide:external-link"
                class="h-3.5 w-3.5 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                aria-hidden="true"
              />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>