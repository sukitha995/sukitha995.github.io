---
import { Icon } from 'astro-icon/components'
import { SKILL_GROUPS } from '../data.js'
---

<section id="skills" class="scroll-mt-24 border-b border-line">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="reveal mx-auto mb-12 max-w-2xl text-center">
      <p class="mb-2 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-widest text-accent">
        <Icon name="lucide:sparkles" class="h-3.5 w-3.5" aria-hidden="true" />
        Skills
      </p>
      <h2 class="text-3xl font-bold sm:text-4xl">Technical Skills</h2>
      <p class="mt-4 text-muted">Tools and technologies I use to build and ship.</p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        SKILL_GROUPS.map((group, index) => (
          <div
            class="reveal group h-full rounded-lg border border-line bg-card p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/5"
            style={`--reveal-delay: ${index * 80}ms`}
          >
            <div class="mb-4 flex items-center gap-3">
              <span
                class="flex h-10 w-10 items-center justify-center rounded-md border border-accent/30 bg-background text-accent transition-transform duration-300 group-hover:scale-110"
              >
                <Icon name={`lucide:${group.icon}`} class="h-[19px] w-[19px]" aria-hidden="true" />
              </span>
              <h3 class="font-semibold">{group.title}</h3>
            </div>
            <ul class="flex flex-wrap gap-2">
              {
                group.skills.map((skill) => (
                  <li
                    class="rounded-full border border-line px-3 py-1 text-xs text-muted transition-all duration-300 hover:border-accent/60 hover:text-ink"
                  >
                    {skill}
                  </li>
                ))
              }
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>